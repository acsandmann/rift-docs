---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const layouts = [
  {
    id: "traditional",
    name: "Traditional",
    title: "Everything in its place.",
    copy: "Split your desktop into horizontal and vertical groups. Keep the windows you need together, and give each one room.",
    tiles: 3,
  },
  {
    id: "scrolling",
    name: "Scrolling",
    title: "More windows. Room to read.",
    copy: "Keep windows in a horizontal strip of columns. As you move focus, Rift brings the selected column into view instead of shrinking every window to fit.",
    tiles: 4,
  },
  {
    id: "bsp",
    name: "BSP",
    title: "One split at a time.",
    copy: "Divide the desktop into a tree of two-way splits. Each division gives you another way to arrange the available space.",
    tiles: 4,
  },
  {
    id: "master-stack",
    name: "Master-stack",
    title: "Give one window the lead.",
    copy: "Keep a primary window in a larger area, with supporting windows tiled beside it.",
    tiles: 4,
  },
  {
    id: "stack",
    name: "Stack",
    title: "Keep your windows large.",
    copy: "Overlap windows in a stack, with the selected window taking most of the space. Switch focus to bring another window forward.",
    tiles: 3,
  },
];
---

<div class="layout-explorer">
  <fieldset>
    <legend class="sr-only">Explore Rift layouts</legend>
    {layouts.map((layout, i) => (
      <Fragment>
        <input
          type="radio"
          name="rift-layout"
          id={`layout-${layout.id}`}
          checked={i === 0}
        />
        <label for={`layout-${layout.id}`}>{layout.name}</label>
      </Fragment>
    ))}
    {layouts.map((layout) => (
      <div class:list={["layout-panel", layout.id]}>
        <div class="diagram" aria-hidden="true">
          <div class="tiles">
            {Array.from({ length: layout.tiles }, () => (
              <span></span>
            ))}
          </div>
        </div>
        <div class="explanation">
          <p class="sr-only">Layout illustration</p>
          <h3>{layout.title}</h3>
          <p>{layout.copy}</p>
          <a href={`${base}/layouts/${layout.id}/`}>
            Explore {layout.name} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    ))}
  </fieldset>
</div>
<style>
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    min-width: 0;
  }
  input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  label {
    cursor: pointer;
    border-bottom: 2px solid transparent;
    padding: 12px 14px;
    font-size: 14px;
    color: var(--apple-secondary-foreground);
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  input:checked + label {
    border-bottom-color: var(--apple-foreground);
    color: var(--apple-foreground);
  }
  input:focus-visible + label {
    outline: 3px solid var(--apple-focus);
    outline-offset: 3px;
  }
  .layout-panel {
    display: none;
    width: 100%;
    grid-template-columns: 1.35fr 1fr;
    align-items: center;
    gap: 8%;
    margin-top: 28px;
    min-height: 340px;
  }
  fieldset:has(#layout-traditional:checked) .traditional,
  fieldset:has(#layout-scrolling:checked) .scrolling,
  fieldset:has(#layout-bsp:checked) .bsp,
  fieldset:has(#layout-master-stack:checked) .master-stack,
  fieldset:has(#layout-stack:checked) .stack {
    display: grid;
  }
  .diagram {
    overflow: hidden;
    border: 1px solid var(--apple-hairline);
    border-radius: 18px;
    background: var(--apple-secondary-background);
    padding: clamp(18px, 3vw, 32px);
  }
  .tiles {
    width: 100%;
    aspect-ratio: 1.5;
    min-width: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 8px;
  }
  .tiles span {
    min-width: 0;
    min-height: 0;
    position: relative;
    border-radius: 5px;
    border: 1px solid
      color-mix(in srgb, var(--apple-foreground) 14%, transparent);
    background: var(--apple-background);
    box-shadow: 0 4px 12px -5px rgb(0 0 0 / 0.12);
  }
  .traditional span:first-child,
  .master-stack span:first-child {
    grid-row: 1 / -1;
  }
  .master-stack .tiles {
    grid-template-columns: 1.5fr 1fr;
    grid-template-rows: repeat(3, 1fr);
  }
  .bsp span:first-child {
    grid-row: 1 / 3;
  }
  .bsp .tiles {
    grid-template-columns: 1fr 0.5fr 0.5fr;
  }
  .bsp span:nth-child(2) {
    grid-column: 2 / 4;
  }
  .scrolling .tiles {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: 1fr;
  }
  .scrolling span:nth-child(2) {
    border-color: var(--apple-link);
    background: color-mix(
      in srgb,
      var(--apple-link) 17%,
      var(--apple-background)
    );
  }
  .stack .tiles {
    display: flex;
  }
  .stack .tiles span {
    width: 9%;
  }
  .stack .tiles span:nth-child(2) {
    width: 82%;
  }
  h3 {
    font-size: clamp(25px, 3vw, 34px);
    line-height: 1.1;
    letter-spacing: -0.035em;
    margin: 0 0 16px;
    font-weight: 600;
  }
  p {
    color: var(--apple-secondary-foreground);
    font-size: 17px;
    line-height: 1.55;
    margin: 0 0 20px;
  }
  a {
    color: var(--apple-link);
    text-decoration: none;
    font-size: 16px;
  }
  a:hover {
    text-decoration: underline;
  }
  @media (max-width: 40rem) {
    .layout-panel {
      grid-template-columns: 1fr;
      gap: 28px;
      min-height: 0;
    }
    label {
      padding: 12px 7px;
      font-size: 12px;
    }
    .explanation {
      padding-inline: 4px;
    }
  }
  @media (max-width: 23rem) {
    fieldset {
      gap: 0;
    }
    label {
      padding-inline: 4px;
      font-size: 11px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    label {
      transition: none;
    }
  }
</style>
