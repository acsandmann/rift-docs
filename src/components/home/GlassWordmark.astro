<style>
  .glass-wrap { background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(83,118,155,.10), transparent); position: relative; width: clamp(240px, 30vw, 340px); max-width: 100%; margin: -25px auto -30px; pointer-events: none; }
  :global(:root[data-theme="dark"]) .glass-wrap { background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(120,165,205,.12), transparent); }
  .glass-canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; }
  .glass-wrap.ready .glass-canvas { opacity: 1; }
  .glass-wrap.ready .wordmark-glow, .glass-wrap.ready .wordmark-line, .glass-wrap.ready .wordmark-highlight { visibility: hidden; }
   .wordmark {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    overflow: visible;
    animation: write-rift 0.8s ease-out both;
  }
   .wordmark-glow { fill: #667485; opacity: 0.08; filter: blur(70px); }
   .wordmark-line { fill: url(#rift-gradient); filter: url(#rift-glass); }
   .wordmark-highlight { fill: none; stroke: #fff; stroke-width: 12; opacity: 0.25; }
   .metal-1 { stop-color: #43596e; }
   .metal-2 { stop-color: #a6bacb; }
   .metal-3 { stop-color: #61798d; }
   .metal-4 { stop-color: #8498aa; }
  :global(:root[data-theme="dark"])  .metal-1 { stop-color: #8797a9; }
  :global(:root[data-theme="dark"])  .metal-2 { stop-color: #d6e0e9; }
  :global(:root[data-theme="dark"])  .metal-3 { stop-color: #8e9dad; }
  :global(:root[data-theme="dark"])  .metal-4 { stop-color: #b5c1ce; }
  :global(:root[data-theme="dark"])  .wordmark-glow { opacity: 0.25; }
  @keyframes write-rift {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0); }
  }
  @media (prefers-reduced-motion: reduce) {
     .wordmark { animation: none; }
  }

</style>
