<rift-theme-toggle>
  <button type="button" aria-label="Switch to dark theme" title="Switch to dark theme">
    <svg
      class="moon"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>

    <svg
      class="sun"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2" />
      <path d="M12 20v2" />
      <path d="m4.93 4.93 1.41 1.41" />
      <path d="m17.66 17.66 1.41 1.41" />
      <path d="M2 12h2" />
      <path d="M20 12h2" />
      <path d="m6.34 17.66-1.41 1.41" />
      <path d="m19.07 4.93-1.41 1.41" />
    </svg>
  </button>
</rift-theme-toggle>

<style>
  rift-theme-toggle {
    display: flex;
    align-items: center;
  }

  button {
    display: grid;
    place-items: center;

    width: 2rem;
    height: 2rem;
    padding: 0;

    border: 0;
    border-radius: 50%;

    background: transparent;
    color: var(--sl-color-text);

    cursor: pointer;

    transition:
      background-color 120ms ease,
      color 120ms ease;
  }

  button:hover {
    background: var(--sl-color-gray-6);
  }

  button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .sun {
    display: none;
  }

  :global(html[data-theme='dark']) .sun {
    display: block;
  }

  :global(html[data-theme='dark']) .moon {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'starlight-theme';

  class RiftThemeToggle extends HTMLElement {
    observer?: MutationObserver;

    connectedCallback() {
      const button = this.querySelector('button');

      if (!button || button.dataset.ready) return;

      button.dataset.ready = 'true';

      const isDark = () =>
        document.documentElement.dataset.theme === 'dark';

      const update = () => {
        const label = isDark()
          ? 'Switch to light theme'
          : 'Switch to dark theme';

        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
      };

      button.addEventListener('click', () => {
        const theme = isDark() ? 'light' : 'dark';

        document.documentElement.dataset.theme = theme;

        try {
          localStorage.setItem(STORAGE_KEY, theme);
        } catch {}

        update();
      });

      this.observer = new MutationObserver(update);

      this.observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });

      update();
    }

    disconnectedCallback() {
      this.observer?.disconnect();
    }
  }

  if (!customElements.get('rift-theme-toggle')) {
    customElements.define('rift-theme-toggle', RiftThemeToggle);
  }
</script>
