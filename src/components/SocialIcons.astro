---
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';

const links = config.social || [];
const trackSocialLinks = !Astro.url.pathname.includes('/reference/');
const getEventName = (icon) => {
	if (!trackSocialLinks) return undefined;
	if (icon === 'github') return 'github_link';
	if (icon === 'matrix') return 'matrix_link';
	if (icon === 'heart') return 'sponsor_header_link';
	return undefined;
};
---

{
	links.length > 0 && (
		<>
			{links.map(({ label, href, icon }) => (
				<a
					{href}
					rel="me"
					class:list={['sl-flex', { 'social-link--sponsor': icon === 'heart' }]}
					aria-label={label}
					title={icon === 'heart' ? label : undefined}
					data-umami-event={getEventName(icon)}
				>
					<Icon name={icon} />
					<span class="sr-only">{label}</span>
				</a>
			))}
		</>
	)
}

<style>
	@layer starlight.core {
		a {
			color: var(--sl-color-text-accent);
			padding: 0.5em;
			margin: -0.5em;
		}
		a:hover {
			color: var(--sl-color-white);
		}
	}
</style>
